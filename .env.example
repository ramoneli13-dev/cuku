# Valores públicos del proyecto de Supabase. No pongas aquí la service_role key.
SUPABASE_URL="https://TU_PROYECTO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REEMPLAZAR"

# Solo servidor. Necesaria para guardar y conciliar órdenes de pago.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_REEMPLAZAR"

# Wompi: la llave pública puede llegar al navegador; los secretos nunca.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_REEMPLAZAR"
WOMPI_INTEGRITY_SECRET="test_integrity_REEMPLAZAR"
WOMPI_EVENTS_SECRET="test_events_REEMPLAZAR"

# WhatsApp Business Cloud API para avisar al equipo de operaciones.
WHATSAPP_CLOUD_TOKEN="REEMPLAZAR"
WHATSAPP_PHONE_NUMBER_ID="REEMPLAZAR"
WHATSAPP_OPERATIONS_NUMBER="57XXXXXXXXXX"
WHATSAPP_GRAPH_API_VERSION="v23.0"

# Transferencias directas. Usa únicamente un QR oficial de tu entidad.
# Para QR dinámico, el endpoint debe responder: qrImageUrl, providerPaymentId y expiresAt.
DIRECT_TRANSFER_QR_API_URL="https://API_OFICIAL_DEL_PROVEEDOR/crear-qr"
DIRECT_TRANSFER_QR_API_TOKEN="REEMPLAZAR"
# Alternativa temporal: URL HTTPS o data:image del QR oficial estático.
DIRECT_TRANSFER_QR_IMAGE_URL=""

# Secreto compartido con el adaptador bancario que confirma el abono real.
DIRECT_TRANSFER_WEBHOOK_SECRET="REEMPLAZAR_CON_32_O_MAS_CARACTERES"

# OCR visual: solo servidor. La imagen no se guarda en la base de datos.
OPENAI_API_KEY="REEMPLAZAR"
OPENAI_VISION_MODEL="gpt-5-mini"
